{
  "name": "dsh-vod-devkit",
  "version": "0.2.0",
  "description": "VOD user-voice collection tools for DeepSeek Harness (dsh). Thin shell over the VOD external HTTP API — mirrors vod-devkit (MCP) collect semantics.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "vod",
    "feedback"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.3.1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "scripts": {
    "build-client": "esbuild src/client.jsx --jsx=automatic --format=cjs --minify --outfile=/tmp/client-cjs.js && python3 scripts/wrap_client.py"
  }
}