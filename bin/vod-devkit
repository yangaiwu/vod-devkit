#!/usr/bin/env python3
"""vod-devkit 安装器入口（薄壳）。

实现在 vodkit_cli/ 包内（F8：1245 行单体按命令域拆分）。这里只做两件事：
① 把包根塞进 sys.path（脚本直跑时可得）；② 引出 main 与对外稳定面
（PRESETS / detect_targets / build_info / write_build_info —— 测试与文档依赖）。

首个参数是 `serve` 时整体透传给 MCP server（不读任何安装配置）。
"""
import os
import sys
from pathlib import Path

# 入口显式设根（D-structure-1 S3：paths.py 只读不猜）。仓内形态=包在 src/、
# 分发态在仓根；载荷/插件副本形态两者同指（包与资产都平铺在根下）。
_DIST = Path(__file__).resolve().parent.parent
_SRC = _DIST / "src" if (_DIST / "src" / "vod_mcp").is_dir() else _DIST
# 注意：**不在 import 期写 env**——本文件会被测试用 SourceFileLoader 当模块加载
# （取 PRESETS/detect_targets），import 期写 env 会把"外层仓的根"泄漏进整场测试，
# 让"复制仓再跑安装器"的用例把 manifest 写到外层仓（实测踩过）。sys.path 无此风险。
sys.path.insert(0, str(_SRC))
sys.path.insert(0, str(_DIST))

from vodkit_cli import main  # noqa: E402
from vodkit_cli.common import PRESETS, build_info, write_build_info  # noqa: E402
from vodkit_cli.install import detect_targets  # noqa: E402

# 对外稳定面（测试按路径加载本文件后直接取这几个名字；pyflakes 认 __all__）
__all__ = ["main", "PRESETS", "detect_targets", "build_info", "write_build_info"]

if __name__ == "__main__":
    # 继承到一个**过期**的根会让整个 CLI 用错仓（表现是"未知宿主 xxx（可选：）"这类
    # 无从解释的错，评审实测复现过一次）。显式设置仍被尊重（测试注入/重定位要用它），
    # 但必须当场说清是哪来的——静默用错根比报错更难查。
    for _name, _want in (("VOD_DEVKIT_SRC_ROOT", _SRC), ("VOD_DEVKIT_DIST_ROOT", _DIST)):
        _got = os.environ.get(_name)
        if _got and Path(_got).resolve() != _want.resolve():
            print(f"[vod-devkit] warn: 继承的 {_name}={_got} 不是本入口所在的仓"
                  f"（{_want}）——若命令行为异常，先 unset 它", file=sys.stderr)
    os.environ.setdefault("VOD_DEVKIT_SRC_ROOT", str(_SRC))
    os.environ.setdefault("VOD_DEVKIT_DIST_ROOT", str(_DIST))
    main()
