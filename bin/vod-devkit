#!/usr/bin/env python3
"""vod-devkit 安装器 CLI（骨架）：install / status / doctor / verify / uninstall。

当前支持目标：hermes。install 做三件事：落 MCP 配置片段、拷 skills、
写 install-manifest（commitSHA 来源主键）。
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
HERMES_MCP_DIR = Path.home() / ".hermes" / "mcp"  # 约定：写入前打印供确认
HERMES_SKILLS_DIR = Path.home() / ".hermes" / "skills" / "devops" / "vod-devkit"


def git_sha(strict: bool) -> str | None:
    dirty = bool(subprocess.run(["git", "status", "--porcelain"], cwd=ROOT,
                                capture_output=True).stdout.strip())
    if strict and dirty:
        print("工作区不干净，拒绝构建（构建纪律）", file=sys.stderr)
        sys.exit(1)
    sha = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT,
                         capture_output=True, text=True).stdout.strip()
    return sha or None


def _safe_remote(url: str) -> str:
    """凭据脱敏：oauth2:xxx@ / https://user:pass@ 一律剥离。"""
    import re as _re
    return _re.sub(r"(https?://)([^@/]+@)", r"\1", url)


def build_info(strict: bool = False) -> dict:
    from vod_mcp import __version__
    remote = subprocess.run(["git", "remote", "get-url", "origin"], cwd=ROOT,
                            capture_output=True, text=True).stdout.strip()
    return {
        "version": __version__,
        "commitSha": git_sha(strict),
        "builtAt": datetime.datetime.now().isoformat(timespec="seconds"),
        "sourceRemote": _safe_remote(remote) if remote else None,
    }


def write_build_info(strict: bool):
    info = build_info(strict)
    (ROOT / "build-info.json").write_text(
        json.dumps(info, ensure_ascii=False, indent=2), encoding="utf-8")
    print("build-info.json:", json.dumps(info, ensure_ascii=False))


def manifest_path() -> Path:
    return ROOT / "install-manifest.json"


PRESETS = {
    # 对外默认：开发者=反馈采集者（workflow 不进对外默认集）
    "collect": "core,collect",
    # 内部：运营/可信第三方全量（含分析发起）
    "full": "core,workflow,kb,collect",
}


def cmd_install(args):
    write_build_info(strict=False)
    target = args.target
    if target != "hermes":
        print(f"暂不支持目标: {target}（当前仅 hermes）", file=sys.stderr)
        sys.exit(2)
    packs = args.packs or PRESETS.get(args.preset, "")
    HERMES_MCP_DIR.mkdir(parents=True, exist_ok=True)
    mcp_conf = HERMES_MCP_DIR / "vod-devkit.json"
    server_entry = str(ROOT / "vod_mcp" / "server.py")
    mcp_conf.write_text(json.dumps({
        "name": "vod-devkit",
        "command": sys.executable,
        "args": [server_entry],
        "env": {
            "VOD_API_BASE": args.api_base,
            "VOD_API_KEY": os.environ.get("VOD_API_KEY", ""),
            "VOD_JAVA_API_BASE": args.java_api_base,
            "VOD_JAVA_API_KEY": os.environ.get("VOD_JAVA_API_KEY", ""),
            "VOD_PACKS": packs,
        },
    }, ensure_ascii=False, indent=2), encoding="utf-8")

    # G1 修复：技能全量拷贝（目录型技能+平铺规则文档），按 packs 过滤
    HERMES_SKILLS_DIR.mkdir(parents=True, exist_ok=True)
    pack_set = set(p for p in packs.split(",") if p)
    for entry in sorted((ROOT / "skills").iterdir()):
        if entry.is_dir():  # vod-core / vod-feedback-collect
            skill = entry.name
            if skill == "vod-core" and "core" not in pack_set:
                continue
            if skill == "vod-feedback-collect" and "collect" not in pack_set:
                continue
            dst = HERMES_SKILLS_DIR / skill
            if dst.exists():
                shutil.rmtree(dst)
            shutil.copytree(entry, dst)
        # vendored 领域规则已由 vendor_rules.py 落成技能目录结构

    bi = json.loads((ROOT / "build-info.json").read_text(encoding="utf-8"))
    manifest = {
        "product": "vod-devkit",
        "version": bi["version"],
        "source": {"type": "git", "remote": bi["sourceRemote"],
                   "ref": subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
                                         cwd=ROOT, capture_output=True, text=True).stdout.strip(),
                   "commitSha": bi["commitSha"]},
        "target": target,
        "installedAt": datetime.datetime.now().isoformat(timespec="seconds"),
        "preset": args.preset,
        "packs": packs,
        "mcpConfig": str(mcp_conf),
        "skillsDir": str(HERMES_SKILLS_DIR),
    }
    manifest_path().write_text(json.dumps(manifest, ensure_ascii=False, indent=2),
                               encoding="utf-8")
    print("installed:", json.dumps(manifest, ensure_ascii=False, indent=2))
    # Hermes 真实接入机制：hermes mcp add（写 config.yaml mcp_servers，非手编文件）
    env_args = []
    for k in ("VOD_API_BASE", "VOD_API_KEY", "VOD_JAVA_API_BASE",
              "VOD_JAVA_API_KEY", "VOD_PACKS"):
        v = json.loads(mcp_conf.read_text(encoding="utf-8"))["env"].get(k, "")
        env_args.extend(["--env", f"{k}={v}"])
    server_entry = str(ROOT / "vod_mcp" / "server.py")  # 脚本绝对路径（非 -m：宿主 cwd 下 -m 找不到包）
    r = subprocess.run(
        ["hermes", "mcp", "add", "vod-devkit",
         "--command", sys.executable,
         *env_args,
         "--args", server_entry],
        input="y\ny\n", capture_output=True, text=True)
    if r.returncode == 0:
        print("已注册到 Hermes MCP（hermes mcp list 可见；重启会话生效）")
    else:
        print(f"警告：hermes mcp add 失败（{r.stderr.strip()[:200]}）——"
              f"请手动执行上述命令")
    missing = [k for k in ("VOD_API_KEY", "VOD_JAVA_API_KEY") if
               not json.loads(mcp_conf.read_text(encoding="utf-8"))["env"].get(k)]
    if missing:
        print(f"警告：{missing} 未配置，网关上线后所有调用将 401（E1 纪律）")


def cmd_status(_args):
    p = manifest_path()
    if not p.exists():
        print("未安装（无 install-manifest）")
        sys.exit(1)
    print(p.read_text(encoding="utf-8"))


def cmd_doctor(_args):
    problems = []
    p = manifest_path()
    if not p.exists():
        problems.append("无 install-manifest.json（未 install？）")
    else:
        mf = json.loads(p.read_text(encoding="utf-8"))
        bi = json.loads((ROOT / "build-info.json").read_text(encoding="utf-8"))
        if mf["source"]["commitSha"] != bi.get("commitSha"):
            problems.append("install-manifest 与 build-info 的 commitSHA 不一致")
        if not Path(mf["mcpConfig"]).exists():
            problems.append("MCP 配置文件缺失")
        if not Path(mf["skillsDir"]).exists():
            problems.append("skills 目录缺失")
    if problems:
        for x in problems:
            print("FAIL:", x)
        sys.exit(1)
    print("doctor: OK")


def cmd_verify(_args):
    p = manifest_path()
    if not p.exists():
        print("未安装")
        sys.exit(1)
    sha = json.loads(p.read_text(encoding="utf-8"))["source"]["commitSha"]
    if not sha:
        print("manifest 无 commitSha（dev 构建无法核验）")
        sys.exit(1)
    r = subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"],
                       cwd=ROOT, capture_output=True)
    if r.returncode != 0:
        subprocess.run(["git", "fetch", "origin"], cwd=ROOT)
        r = subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"],
                           cwd=ROOT, capture_output=True)
    if r.returncode != 0:
        print(f"FAIL: commit {sha} 不存在于 origin（被改写或非本仓产物）")
        sys.exit(1)
    print(f"verify: OK（commit {sha[:12]} 存在于本仓/origin）")


def cmd_uninstall(_args):
    p = manifest_path()
    if p.exists():
        mf = json.loads(p.read_text(encoding="utf-8"))
        for key in ("mcpConfig", "skillsDir"):
            path = Path(mf[key])
            if path.exists():
                shutil.rmtree(path) if path.is_dir() else path.unlink()
                print("removed:", path)
        p.unlink()
        print("removed:", p)
    else:
        print("未安装")


def main():
    ap = argparse.ArgumentParser(prog="vod-devkit")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sp = sub.add_parser("install")
    sp.add_argument("--target", required=True)
    sp.add_argument("--preset", default="collect", choices=list(PRESETS),
                    help="collect=对外默认（采集者）；full=内部全量")
    sp.add_argument("--api-base", default="http://127.0.0.1:8000")
    sp.add_argument("--java-api-base", default="http://127.0.0.1:8090")
    sp.add_argument("--packs", default="", help="显式覆盖 preset（逗号分隔）")
    sp.set_defaults(fn=cmd_install)
    for name, fn in (("status", cmd_status), ("doctor", cmd_doctor),
                     ("verify", cmd_verify), ("uninstall", cmd_uninstall)):
        s = sub.add_parser(name)
        s.set_defaults(fn=fn)
    sub.add_parser("build-info").set_defaults(fn=lambda a: write_build_info(strict=False))
    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
