#!/usr/bin/env python3
"""vod-devkit 安装器 CLI（骨架）：install / status / doctor / verify / uninstall。

当前支持目标：hermes。install 做三件事：落 MCP 配置片段、拷 skills、
写 install-manifest（commitSHA 来源主键）。
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from vod_mcp import hosts as host_specs  # noqa: E402  宿主适配层（数据驱动）

# 路径常量一律来自 integrations/<host>/host.json（单一来源）：新增宿主=加
# 目录，不改这里；平台差异也在数据里（opencode 的 windows 分叉）。
_HERMES_SPEC = host_specs.load("hermes")
HERMES_MCP_DIR = Path(_HERMES_SPEC["configPath"]).parent  # 约定：写入前打印供确认
HERMES_SKILLS_DIR = Path(_HERMES_SPEC["skillsDir"])


def git_sha(strict: bool) -> str | None:
    dirty = bool(subprocess.run(["git", "status", "--porcelain"], cwd=ROOT,
                                capture_output=True).stdout.strip())
    if strict and dirty:
        print("工作区不干净，拒绝构建（构建纪律）", file=sys.stderr)
        sys.exit(1)
    sha = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT,
                         capture_output=True, text=True).stdout.strip()
    return sha or None


def _safe_remote(url: str) -> str:
    """凭据脱敏：oauth2:xxx@ / https://user:pass@ 一律剥离。"""
    import re as _re
    return _re.sub(r"(https?://)([^@/]+@)", r"\1", url)


def build_info(strict: bool = False) -> dict:
    from vod_mcp import __version__
    remote = subprocess.run(["git", "remote", "get-url", "origin"], cwd=ROOT,
                            capture_output=True, text=True).stdout.strip()
    return {
        "version": __version__,
        "commitSha": git_sha(strict),
        "builtAt": datetime.datetime.now().isoformat(timespec="seconds"),
        "sourceRemote": _safe_remote(remote) if remote else None,
    }


def write_build_info(strict: bool):
    info = build_info(strict)
    (ROOT / "build-info.json").write_text(
        json.dumps(info, ensure_ascii=False, indent=2), encoding="utf-8")
    print("build-info.json:", json.dumps(info, ensure_ascii=False))


def manifest_path() -> Path:
    return ROOT / "install-manifest.json"


PRESETS = {
    # 对外默认：开发者=反馈采集者（workflow 不进对外默认集）
    "collect": "core,collect",
    # 内部：运营/可信第三方全量。2026-11-06 修正（深审 P0-2）：原值
    # "core,workflow,kb,collect" 与运行期 ALL_PACKS=(core,collect,knowledge)
    # 命名漂移——workflow 包已随"运营归 vod-system 前端"净删、kb 是
    # knowledge 的旧称，按原值安装 workflow/kb 被静默丢弃（安装口说装了
    # 运行口不认=挪到别处而非消除）
    "full": "core,collect,knowledge",
}


def _server_entry() -> str:
    return str(ROOT / "vod_mcp" / "server.py")


def _server_env(args, packs: str) -> dict:
    # 无 key 不写空串（空串会让探针/严格解析器误当字面值；运行时空=未设置，
    # 自动兜底 runtime.json java_key 或首提申请匿名令牌）
    env = {"VOD_PACKS": packs,
           "VOD_JAVA_API_BASE": args.java_api_base}
    key = os.environ.get("VOD_JAVA_API_KEY", "")
    if key:
        env["VOD_JAVA_API_KEY"] = key
    return env


def _skill_installs(manifest_path: Path, extra_dirs) -> list:
    """多宿主技能落点并集（名册对账）：manifest 按「最近一次安装」覆盖会
    互相冲掉落点（实锤：codex 装完 opencode 落点消失），按 host+dir
    去重保留历史落点。"""
    import json as _json
    import os
    home = str(Path.home()) + os.sep
    prev = {}
    if manifest_path.exists():
        try:
            for si in _json.loads(manifest_path.read_text(encoding="utf-8")).get("skillInstalls") or []:
                d = si.get("dir") or ""
                # 只保留「当前 HOME 之下且目录真实存在」的落点——隔离环境
                # （fake-home 测试）不吞真实 HOME 的历史落点，卸载残留自动剪枝
                if d.startswith(home) and Path(d).is_dir():
                    prev[(si["host"], d)] = si
        except Exception:
            pass
    for h, d in [("hermes", HERMES_SKILLS_DIR)] + list(extra_dirs or []):
        if d is not None:
            prev[(h, str(d))] = {"host": h, "dir": str(d)}
    return sorted(prev.values(), key=lambda x: (x["host"], x["dir"]))


def _dir_hashes(base: Path) -> dict:
    """对既有目录树计算相对 sha256 指纹（roster 对账用）。"""
    import hashlib
    out = {}
    for skill in sorted(Path(base).iterdir()):
        if skill.is_dir():
            for f in sorted(skill.rglob("*")):
                if f.is_file():
                    out[f"{skill.name}/{f.relative_to(skill)}"] = (
                        hashlib.sha256(f.read_bytes()).hexdigest())
    return out


def _skill_hashes() -> dict:
    """技能拷贝件指纹（D-drift-lock）：安装时记录 sha256，verify/doctor 比对
    ——拷贝件与安装产物漂移可检（vendor 规则漂移实锤的针对性防线）。"""
    import hashlib
    out = {}
    for entry in sorted((ROOT / "skills").iterdir()):
        if entry.is_dir():
            for f in sorted(entry.rglob("*")):
                if f.is_file():
                    rel = f"{entry.name}/{f.relative_to(entry)}"
                    out[rel] = hashlib.sha256(f.read_bytes()).hexdigest()
    return out


def _drifted_skills(manifest: dict) -> list:
    """比对 skillsDir 拷贝件与 manifest.skillHashes，返回漂移文件清单。"""
    import hashlib
    base = Path(manifest["skillsDir"])
    drifted = []
    for rel, sha in (manifest.get("skillHashes") or {}).items():
        f = base / rel
        if not f.exists():
            drifted.append(f"{rel}（缺失）")
        elif hashlib.sha256(f.read_bytes()).hexdigest() != sha:
            drifted.append(f"{rel}（内容被改）")
    return drifted


def _install_hermes(args, packs: str) -> Path:
    """Hermes：官方途径 hermes mcp add（config.yaml mcp_servers）。"""
    conf = HERMES_MCP_DIR / "vod-devkit.json"
    conf.parent.mkdir(parents=True, exist_ok=True)
    conf.write_text(json.dumps({
        "name": "vod-devkit", "command": sys.executable,
        "args": [_server_entry()], "env": _server_env(args, packs),
    }, ensure_ascii=False, indent=2), encoding="utf-8")
    env_args = []
    for k, v in _server_env(args, packs).items():
        env_args.extend([k + "=" + v])
    r = subprocess.run(
        ["hermes", "mcp", "add", "vod-devkit", "--command", sys.executable,
         *["--env"] + env_args, "--args", _server_entry()],
        input="y\ny\n", capture_output=True, text=True)
    # D-hook-1：强制评估路由插件（pre_llm_call 确定性意图路由，业界 forced-eval 模式）
    import shutil as _sh
    plug_src = ROOT / "hermes-plugin" / "vod-feedback-router"
    plug_dst = Path.home() / ".hermes" / "plugins" / "vod-feedback-router"
    if plug_src.is_dir():
        if plug_dst.exists():
            _sh.rmtree(plug_dst)
        _sh.copytree(plug_src, plug_dst)
        print("已安装 vod-feedback-router 路由插件（~/.hermes/plugins/）；"
              "需在 plugins.enabled 加入该名单后生效"
              "（hermes config set plugins.enabled ...，重启会话生效）")
    if r.returncode == 0:
        print("已注册 Hermes MCP（hermes mcp list 可见；重启会话生效）")
    else:
        print(f"提示：hermes mcp add 未成功（{r.stderr.strip()[:150]}）；"
              f"可将 {conf} 内容并入 Hermes 配置")
    return conf


def _install_opencode(args, packs: str) -> Path:
    """OpenCode：~/.config/opencode/opencode.json 的 mcp 段无损合并。

    schema 实测要求：command=数组、enabled 必填；既有内容（provider 等）
    原样保留（读改写，只动 mcp.vod-devkit 键）。
    """
    spec = host_specs.load("opencode")
    conf = Path(spec["configPath"])
    conf.parent.mkdir(parents=True, exist_ok=True)
    cfg = {}
    if conf.exists():
        try:
            cfg = json.loads(conf.read_text(encoding="utf-8"))
        except Exception:
            cfg = {}
    cfg.setdefault("mcp", {})["vod-devkit"] = {
        "type": "local",
        "command": [sys.executable, _server_entry()],
        "enabled": True,
        "environment": _server_env(args, packs),
    }
    conf.write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"已写入 OpenCode 配置：{conf}（重启 OpenCode 会话生效）")
    # 随装生成物走 integrations/opencode/ 的模板（单一来源——此前模板正文
    # 硬编码在本函数里，改文案要同时改代码与文档两处）
    for g in spec["generated"]:
        dest = Path(g["dest"])
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(Path(g["template"]).read_text(encoding="utf-8"),
                        encoding="utf-8")
        print(f"已写入 OpenCode 自检命令：/vod-doctor（{dest}）")
    return conf


def _strip_codex_vod_blocks(text: str) -> str:
    """幂等剥离：删除 [mcp_servers.vod-devkit] **及其全部子表**。

    不能用行内正则截断式剥离——args = ["…"] 行内的 '[' 会让正则提前断块。
    也不能只删父表（旧实现）：留下 [mcp_servers.vod-devkit.env] 在 TOML
    语义里会重建父表，装出一个没有 command 的假 server。扫描/删除语义
    统一在 vod_mcp/config_forms.py（单一实现），形态不受支持时抛
    RuntimeError——调用方必须原样放弃修改。
    """
    from vod_mcp import config_forms as cf
    try:
        verdict, reason = cf.classify_codex_toml(text)
    except cf.Refused as e:
        raise RuntimeError(f"codex config.toml 形态不受支持：{e}") from e
    if verdict == "refuse":
        raise RuntimeError(f"codex config.toml 形态不受支持：{reason}")
    cleaned, _removed = cf.strip_managed_toml(text)
    return cleaned


_AGENTS_MARKER_BEGIN = "<!-- vod-devkit:feedback-skill BEGIN -->"
_AGENTS_MARKER_END = "<!-- vod-devkit:feedback-skill END -->"


def _strip_agents_vod_block(text: str) -> str:
    """幂等剥离 AGENTS.md 中带标记的 vod-devkit 技能块（历史方案清理）。

    P2（深审 2026-11-06）：只有 BEGIN 没有 END 时不得静默吞掉文件剩余
    全部内容——抛错拒绝（调用方 exit 2 不落盘），宁可装不上不可删用户文件。
    """
    lines, skipping, out = text.splitlines(), False, []
    for line in lines:
        if line.strip() == _AGENTS_MARKER_BEGIN:
            skipping = True
            continue
        if line.strip() == _AGENTS_MARKER_END:
            skipping = False
            continue
        if not skipping:
            out.append(line)
    if skipping:
        raise RuntimeError(
            "AGENTS.md 存在 vod-devkit BEGIN 标记但缺失 END 标记"
            "（文件可能被手动截断）——拒绝自动清理，请手动检查该文件")
    return "\n".join(out).rstrip()


def _install_codex(args, packs: str) -> Path:
    """Codex（D-codex-agents-1 终态）：原生插件路径——
    codex plugin marketplace add <仓>/plugins + plugin add vod-devkit@vod-local，
    打包 skills（渐进式按需加载的采集工作流）+ .mcp.json（vod-devkit serve）。
    历史遗留清理：旧 config.toml [mcp_servers.vod-devkit] 段与 AGENTS.md 技能块
    一并移除（与原生插件同名会双注册；AGENTS.md 方案被原生 skill 取代）。
    前置：codex CLI 与 vod-devkit 命令在 PATH（npm i -g vod-devkit ≥0.1.12）。"""
    codex = shutil.which("codex")
    if not codex:
        print("[vod-devkit] 未找到 codex CLI，无法走原生插件安装", file=sys.stderr)
        sys.exit(2)
    spec = host_specs.load("codex")
    conf = Path(spec["configPath"])
    if conf.exists():  # 历史遗留：config.toml MCP 段与插件同名=双注册，移除
        text = conf.read_text(encoding="utf-8")
        try:
            cleaned = _strip_codex_vod_blocks(text)
        except RuntimeError as e:
            # 形态守卫：非已知形态宁可不装——改坏用户整份 codex 配置的代价
            # 远高于装不上（字节未动）
            print(f"[vod-devkit] {e}。安装中止，未改动该文件。", file=sys.stderr)
            sys.exit(2)
        if cleaned != text.rstrip():
            conf.write_text(cleaned + "\n", encoding="utf-8")
            print(f"已移除旧 config.toml MCP 段（原生插件取代）：{conf}")
    agents = Path.home() / ".codex" / "AGENTS.md"
    if agents.exists():  # 历史遗留：AGENTS.md 技能块已被原生 skill 取代
        text = agents.read_text(encoding="utf-8")
        try:
            cleaned = _strip_agents_vod_block(text)
        except RuntimeError as e:
            print(f"[vod-devkit] {e}", file=sys.stderr)
            sys.exit(2)
        if cleaned != text.rstrip():
            agents.write_text(cleaned + "\n", encoding="utf-8")
            print(f"已移除旧 AGENTS.md 技能块（原生 skill 取代）：{agents}")
    mp_root = ROOT / "plugins"

    def _run(cmd):
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        if r.returncode != 0:
            raise RuntimeError(f"{' '.join(cmd)} → {r.stderr.strip() or r.stdout.strip()}")
        return r.stdout

    mp_name = "vod-local"
    # devkit 卫生实践：stale cache 先清——codex 插件缓存不自动失效，不清则
    # 重装/升级后旧版本残留（marketplace 指向与 cache 内容漂移）
    for stale in (Path.home() / ".codex" / "plugins" / "marketplaces" / mp_name,
                  Path.home() / ".codex" / "plugins" / "cache" / mp_name):
        if stale.exists():
            shutil.rmtree(stale)
            print(f"已清理 stale 插件缓存：{stale}")
    ml = subprocess.run([codex, "plugin", "marketplace", "list"], capture_output=True, text=True, timeout=120).stdout
    if mp_name not in ml:
        _run([codex, "plugin", "marketplace", "add", str(mp_root)])
        print(f"已注册本地 marketplace：{mp_root}")
    _run([codex, "plugin", "add", f"vod-devkit@{mp_name}"])
    print("已安装 codex 原生插件 vod-devkit（skills + MCP，重启 Codex 会话生效）")
    # P1-5（深审 2026-11-06）：插件自带的 .mcp.json 硬编码 env.VOD_PACKS=
    # core,collect——--packs 对 codex 半失效（运行期仍注册 collect 工具）。
    # plugin add 后把缓存内 .mcp.json 的 packs 对齐本次安装值。
    import glob as _glob
    mcp_jsons = sorted(
        _glob.glob(str(Path.home() / ".codex" / "plugins" / "cache"
                       / mp_name / "vod-devkit" / "*" / ".mcp.json")),
        key=lambda p: Path(p).stat().st_mtime, reverse=True)
    if mcp_jsons:
        try:
            mj = json.loads(Path(mcp_jsons[0]).read_text(encoding="utf-8"))
            srv = mj.get("mcpServers", {}).get("vod-devkit")
            if srv is not None:
                srv.setdefault("env", {})["VOD_PACKS"] = packs
                Path(mcp_jsons[0]).write_text(
                    json.dumps(mj, ensure_ascii=False, indent=2) + "\n",
                    encoding="utf-8")
                print(f"已对齐插件 MCP packs：{mcp_jsons[0]}（VOD_PACKS={packs}）")
        except Exception as e:
            print(f"[vod-devkit] warn: 插件 .mcp.json packs 对齐失败（{e}）——"
                  "运行期熔断门禁仍会兜底", file=sys.stderr)
        return Path(mcp_jsons[0])
    # 深审 P0-3：绝不再返回 ~/.codex/config.toml——它是用户整份 codex 配置，
    # uninstall 对 mcpConfig 是删除语义，指向它=卸载删光用户配置（破坏性）
    print("[vod-devkit] warn: 未定位到插件 .mcp.json（uninstall 将跳过 MCP 清理，"
          "可手动删除插件缓存目录）", file=sys.stderr)
    return None


def _install_dsh(args, packs: str) -> Path:
    """dsh 工具壳（D-dsh-install-1，2026-11-06 用户拍板 A）：三壳口径统一——
    --product 安装期硬校验（cmd_install 已先行，到达此处必已过）+ 校验先于
    add + 幂等写 profile cordis.patch.yml config override。
    生效通道真机实测（2026-11-06，dsh 0.2.1-rc.5）：profile cordis.patch.yml
    的 id-targeted config override 是工具壳读取 product/apiBase/uiBase/
    confirmWrites 的唯一运行时通道（启动 banner + 桩引擎提交链实证）。
    uiBase（D-uiBase-direct）：浏览器半（反馈按钮）直连引擎——apiBase 是
    server 半（Node）自用，浏览器同源策略下用不上；缺 uiBase 时 UI 提交
    发往 dsh 同源（404→本地暂存），嵌入方真机实锤。dsh plugin add 会自建
    profile，无需前置。"""
    dsh = shutil.which("dsh")
    profile = (getattr(args, "dsh_profile", "") or "").strip()
    if not profile:
        # argparse 进入安装前校验（cmd_install 已兜底，直调防御）
        print("[vod-devkit] --profile 必填：dsh 按 profile 组织插件与配置"
              "（--profile <name>）", file=sys.stderr)
        sys.exit(2)
    if not dsh:
        print("[vod-devkit] 未找到 dsh CLI（PATH），拒绝安装（宁可不装不可装错）。"
              "前置：npm i -g @deepseek-ai/dsh（需 pnpm）", file=sys.stderr)
        sys.exit(2)
    r = subprocess.run([dsh, "plugin", "--profile", profile,
                        "add", "dsh-vod-devkit"],
                       capture_output=True, text=True, timeout=300)
    if r.returncode != 0:
        print(f"[vod-devkit] dsh plugin add 失败：{(r.stderr or r.stdout).strip()[-300:]}",
              file=sys.stderr)
        sys.exit(1)
    print(f"已安装 dsh 插件 dsh-vod-devkit（profile={profile}，dsh plugin list 可见）")

    patch = Path(host_specs.load("dsh", profile)["configPath"])
    # name 行必须保留：cordis.patch.yml 的 insert 块靠 name 绑定 client 半
    # （反馈按钮）——只写 id+config 会在重装幂等替换时把 name 吞掉，UI 静默
    # 失激活（2026-11-06 真机实锤：重装后入口消失）
    # 嵌套铁律（2026-11-10 真机实锤）：块必须缩进在 `- insert:` 之下——平铺
    # 形态被 dsh 组合层丢弃，插件掉出组合树（banner/工具/UI 全消失）。
    # 归因先验（D-attrib-B）：--product 可选；空值时写 '' 而非空值
    # （dsh 壳 config schema 是 z.string().default('')，YAML null 会校验失败）
    prod_yaml = args.product or "''"
    block = ("- insert:\n"
             "    - id: vod-devkit\n"
             "      name: dsh-vod-devkit\n"
             "      config:\n"
             f"        product: {prod_yaml}\n"
             f"        apiBase: {args.java_api_base}\n"
             f"        uiBase: {args.java_api_base}\n"  # D-uiBase-direct：浏览器半直连引擎
             "        # headless 无审批通道：原生 ask 门禁会永久阻断写工具（四宿主实测实锤：\n"
             "        # requires approval, but no approval channel）。同意确认由 SKILL 话术层\n"
             "        # 承担（draft→用户确认→commit / 明确指令直发），web 端如需硬门禁按\n"
             "        # profile 覆盖回 true。\n"
             "        confirmWrites: false\n")
    try:
        written = _upsert_dsh_patch(patch, block)
    except Exception as e:
        # 回滚/修复指引：插件已装但配置未写 = 半成品，给明确的手动修复格式。
        # 区分两类失败：形态守卫拒绝（文件合法但不在已知形态内，字节未动）
        # 与真实 IO 失败——两者的处置动作不同，文案必须能分辨。
        print(f"[vod-devkit] 插件已装入 profile={profile}，但配置写入失败"
              f"（{e.__class__.__name__}: {e}；该文件未被改动）。请手动把下段并入 {patch}"
              f"（顶层 YAML 数组元素，已有 - id: vod-devkit 段则原位替换）：\n"
              f"{block}", file=sys.stderr)
        sys.exit(1)
    if written:
        print(f"已写入归因/引擎配置（幂等 upsert）：{patch}")
    else:
        print(f"配置未变化（幂等跳过）：{patch}")
    return patch


def _find_dsh_block(lines):
    """定位 cordis.patch.yml 中 vod-devkit 块的 (start, end)。

    扫描/边界语义统一在 vod_mcp/config_forms.find_dsh_block（单一实现，
    install 的幂等 upsert、uninstall 摘除、doctor 自愈三处共用——两处扫描
    规则漂移在本仓 dsh 壳上实锤过）。本函数只保留名字兼容调用点。
    """
    from vod_mcp import config_forms as cf
    return cf.find_dsh_block(lines)


def _upsert_dsh_patch(patch: Path, block: str) -> bool:
    """幂等写 profile cordis.patch.yml：已存在 `- id: vod-devkit` 段则原位整块
    替换（不重复插入）；无则追加。按行扫描块边界（下一行 `- ` 顶层元素或 EOF），
    不引 YAML 依赖（本仓零第三方依赖红线）。返回是否有写入。"""
    from vod_mcp import config_forms as cf
    lines = patch.read_text(encoding="utf-8").splitlines() if patch.exists() else []
    # 形态守卫（先分类后改字节）：非已知形态一律拒绝——这个文件坏掉等于
    # 整个 dsh profile 起不来（`[]` 占位实锤），比装不上代价高得多
    try:
        verdict, reason = cf.classify_dsh_patch(lines)
    except cf.Refused as e:
        raise RuntimeError(f"cordis.patch.yml 形态不受支持：{e}") from e
    if verdict == "refuse":
        raise RuntimeError(f"cordis.patch.yml 形态不受支持：{reason}")
    start, end = _find_dsh_block(lines)
    if start is None:
        # 空数组占位清除（四宿主实测实锤：dsh plugin add 自建的模板含字面量
        # `[]` 顶层行，直接追加块 = `[]` 后跟 `- id:` 顶层元素 = 非法 YAML，
        # 整个 profile 启动崩溃）。`[]` 语义=空数组，被块 entries 取代即删。
        lines = [ln for ln in lines if ln.strip() != "[]"]
        new = lines + ([""] if lines and lines[-1].strip() else []) + block.splitlines()
    else:
        new = lines[:start] + block.splitlines() + lines[end:]
    new_text = "\n".join(new).rstrip("\n") + "\n"
    # 空 `- insert:` 组头清理（损坏态自愈）：孤儿组头（下一个顶层元素前无
    # 子项）来自历史平铺替换的残留——留它在 dsh 组合层是空组，可能拖垮
    # 整个 patch 解析。upsert 后顺手摘除（幂等，不碰正常组）。
    cleaned = []
    for idx, ln in enumerate(new):
        if ln.strip() == "- insert:":
            nxt = new[idx + 1] if idx + 1 < len(new) else ""
            if nxt.startswith("- ") or (not nxt.strip() and idx + 2 >= len(new)):
                continue  # 孤儿组头：下一行已是新顶层元素（无子项）→ 摘除
        cleaned.append(ln)
    new_text = "\n".join(cleaned).rstrip("\n") + "\n"
    old_text = patch.read_text(encoding="utf-8") if patch.exists() else ""
    if new_text == old_text:
        return False
    patch.parent.mkdir(parents=True, exist_ok=True)
    patch.write_text(new_text, encoding="utf-8")
    return True


def _remove_dsh_patch_block(patch: Path) -> bool:
    """从 cordis.patch.yml 摘除 vod-devkit 块（uninstall 用）。返回是否摘除。"""
    if not patch.exists():
        return False
    from vod_mcp import config_forms as cf
    lines = patch.read_text(encoding="utf-8").splitlines()
    try:
        verdict, reason = cf.classify_dsh_patch(lines)
    except cf.Refused as e:
        verdict, reason = "refuse", str(e)
    if verdict == "refuse":
        # 卸载路径同样不动字节：文件已经坏了，再"尽力删"只会让故障更难定位
        print(f"[vod-devkit] skip（cordis.patch.yml 形态不受支持，未改动）：{reason}",
              file=sys.stderr)
        return False
    start, end = _find_dsh_block(lines)
    if start is None:
        return False
    patch.write_text(
        "\n".join(lines[:start] + lines[end:]).rstrip("\n") + "\n",
        encoding="utf-8")
    return True


_INSTALLERS = {"hermes": _install_hermes, "opencode": _install_opencode,
               "codex": _install_codex, "dsh": _install_dsh}


def detect_targets() -> list:
    """0/1/N 探测：按 host.json 的 detect 段判断宿主是否在场（CLI 或配置目录）。"""
    found = []
    for host in host_specs.hosts():
        spec = host_specs.load(host)
        if spec.get("detectCLI") and shutil.which(spec["detectCLI"]):
            found.append(host)
        elif spec.get("detectPath") and Path(spec["detectPath"]).exists():
            found.append(host)
    return found


def _validate_product_or_exit(product: str, base: str) -> bool:
    """D-product-id-2：安装期产品硬校验（B 案，2026-11-05 拍板）。
    --product 命中 meta productCatalog（名字大小写不敏感或 id 精确）才放行；
    未命中/目录不可达一律拒绝安装并给可执行引导（宁可不装不可装错）。"""
    import urllib.request
    import urllib.error
    import uuid
    api_prefix = "/rest/developer/manager/hdvodmngservice/v1"
    key = os.environ.get("VOD_JAVA_API_KEY", "")
    token = ""
    # 全程一致的设备锚点（S1 设备绑定：token 与后续请求必须同 device/UA，
    # 否则 meta 401 设备不匹配；每次装机一个新锚点，一次校验只耗一枚令牌）
    device = uuid.uuid4().hex[:32]
    ua = "vod-devkit-installer/1"

    def _get(url: str):
        auth = key or token
        req = urllib.request.Request(url, headers={
            "content-type": "application/json",
            "X-Vod-Device-Id": device,
            "User-Agent": ua,
            **({"authorization": f"Bearer {auth}"} if auth else {}),
        })
        with urllib.request.urlopen(req, timeout=10) as resp:
            return resp.status, resp.read().decode("utf-8", "replace")

    try:
        if not key:
            req = urllib.request.Request(  # 零字段匿名令牌（方案 C 同链）
                f"{base}{api_prefix}/external/token", data=b"{}",
                headers={"content-type": "application/json", "X-Vod-Device-Id": device,
                         "User-Agent": ua}, method="POST")
            with urllib.request.urlopen(req, timeout=10) as resp:
                body = json.loads(resp.read().decode("utf-8", "replace") or "{}")
            token = (body.get("data") or {}).get("token") or body.get("token") or ""
        catalog = None
        status, text = _get(f"{base}{api_prefix}/external/meta")
        data = (json.loads(text) or {}).get("data") or {}
        catalog = data.get("productCatalog")
        if not catalog and token:  # 老引擎 meta 无目录 → 退 /external/products
            status, text = _get(f"{base}{api_prefix}/external/products") if not key else (None, None)
            if text:
                data = (json.loads(text) or {}).get("data") or []
                catalog = data
        if not catalog:
            print("[vod-devkit] 产品校验失败：引擎 meta 无 productCatalog 且 /external/products 不可用。\n"
                  "  不执行安装（宁可不装不可装错）。请核对 --java-api-base 指向的引擎是否已部署 T7i 版本。",
                  file=sys.stderr)
            sys.exit(2)
        p = product.strip()
        hit = any(
            (str(x.get("name") or "").lower() == p.lower())
            or (str(x.get("id")) == p)
            for x in catalog if isinstance(x, dict))
        if not hit:
            sample = " / ".join(str(x.get("name")) for x in catalog[:8] if isinstance(x, dict))
            print(f"[vod-devkit] --product '{product}' 不在产品名录（t_vod_product），拒绝安装。\n"
                  "  归因前提无效=内置采集技能/分类/透传全部空转且用户无感知（归因错误比报错更糟）。\n"
                  f"  权威名单：GET {api_prefix}/external/products（共 {len(catalog)} 项），示例：{sample} …",
                  file=sys.stderr)
            sys.exit(2)
        return True
    except SystemExit:
        raise
    except Exception as e:
        print(f"[vod-devkit] 产品校验不可达（{e.__class__.__name__}），拒绝安装（宁可不装不可装错）。\n"
              "  请核对网络与 --java-api-base；确需离线安装请联系 VOD 运营。",
              file=sys.stderr)
        sys.exit(2)


def cmd_install(args):
    from vod_mcp import DEFAULT_JAVA_BASE
    if not args.java_api_base:
        # 优先级：--java-api-base > env VOD_JAVA_API_BASE > DEFAULT_JAVA_BASE
        #（env 与插件运行时同键，安装器跟随同链；测试/CI 用 env 指桩引擎零外呼）
        args.java_api_base = os.environ.get("VOD_JAVA_API_BASE") or DEFAULT_JAVA_BASE
    write_build_info(strict=False)
    target = args.target
    if target == "auto":
        found = detect_targets()
        if len(found) == 1:
            target = found[0]
        elif not found:
            print("未探测到任何宿主；用 --target hermes|opencode|codex 显式指定",
                  file=sys.stderr)
            sys.exit(2)
        else:
            print(f"探测到多个宿主: {found}；请 --target 显式指定其一", file=sys.stderr)
            sys.exit(2)
        print(f"探测到宿主: {target}")
    installer = _INSTALLERS.get(target)
    if installer is None:
        print(f"不支持目标: {target}（可选 hermes|opencode|codex|auto）", file=sys.stderr)
        sys.exit(2)
    packs = args.packs or PRESETS.get(args.preset, "")
    # 恢复门禁（D-codex-circuit-breaker-1，2026-11-06 负责人确认）：
    # 熔断标记存在（~/.codex/vod-collect-suspended.json）时，codex 装 collect
    # 被拒——恢复采集的前置=token 化上线并过回归，不是改回 packs 一个动作；
    # --ack-suspension=显式解除（P1-4 修正：解除动作后置到安装成功之后——
    # 若产品校验/安装中途失败，熔断不得已被解除）。
    pending_ack = False
    if target == "codex" and "collect" in (packs or "").replace(" ", "").split(","):
        marker = Path.home() / ".codex" / "vod-collect-suspended.json"
        if marker.is_file() and getattr(args, "ack_suspension", False):
            pending_ack = True  # 解除后置：安装成功才落
        elif marker.is_file():
            print("[vod-devkit] 恢复门禁：codex 采集处于熔断状态"
                  "（未确认提交 ≥2 次，详见 docs/decisions.md"
                  " D-codex-circuit-breaker-1）。"
                  "恢复前置=token 化两段式上线并通过回归"
                  "（draft→commit 审计链/重复 commit 被拒/未确认可检测）。",
                  file=sys.stderr)
            sys.exit(2)
    # 归因绑定降级（D-attrib-B，2026-11-11 负责人拍板 P1-P4 全 A）：--product
    # 由必填改为**可选先验**——归因主路径改成运行期从用户原话解析（证据唯一
    # 命中才采信），安装绑定只在「无字面证据且无记忆」时兜底。保留「给了就
    # 必须对」：显式提供时仍做名录硬校验（拼错照样 exit 2），不给不拦装。
    # D-dsh-install-1：--profile 必填在进入任何安装动作前校验（先校验后写入）
    if target == "dsh" and not (args.dsh_profile or "").strip():
        print("[vod-devkit] --profile 必填：dsh 按 profile 组织插件与配置。\n"
              "  例：npx vod-devkit install --target dsh --profile web --product CodeArts",
              file=sys.stderr)
        sys.exit(2)
    bound_product = args.product
    # D-product-id-2（2026-11-05 用户拍板 B，推翻"宿主名是显式合法值"宽容口径）：
    # 安装期产品硬校验——--product 必须命中 meta productCatalog（名字大小写不敏感
    # 或平台主键 id 精确）。理由：--product 是整条采集链（内置采集技能/分类/透传）
    # 的归因前提，装错=全套 skill 逻辑空转且用户无感知；归因错误比报错更糟。
    # 目录不可达（离线/引擎异常）同样拒绝——宁可不装不可装错（postinstall 拒绝
    # 猜测同源纪律）。插件提交链的 name 兼容通道不受影响（那是老版本插件兼容，
    # 不是安装期放行理由）。
    if args.product:  # 可选先验：给了就校验，不给不拦装（D-attrib-B）
        _validate_product_or_exit(args.product, args.java_api_base)
    # D-key-guard-2 红线：preset（产品分发）形态下 key 禁止随包——环境变量里的
    # key 不透传给宿主配置（客户机一律走匿名令牌自领），并当场告警
    distribution = args.distribution
    if distribution == "preset" and os.environ.pop("VOD_JAVA_API_KEY", None):
        print("[vod-devkit] warn: preset 形态下 VOD_JAVA_API_KEY 已忽略且不写入宿主配置"
              "（key 落在哪台机器哪台就是信任边界；客户机走匿名令牌）", file=sys.stderr)
    rt = ROOT / "vod_mcp" / "runtime.json"
    cfg = {}
    if rt.exists():
        try:
            cfg = json.loads(rt.read_text(encoding="utf-8"))
        except Exception:
            cfg = {}
    cfg["product"] = bound_product
    if getattr(args, "no_local_ledger", False):
        # D-key-guard-3④：企业数据驻留要求可关本地账本（代价 vod_list_submitted 不可用）
        cfg["local_ledger"] = False
    # base 同步落 runtime.json：宿主 env 透传不稳是实测坑，透传挂了静默落回
    # 127.0.0.1:8090；文件兑底与 env 同值不构成双真源（优先级链 env>文件）
    cfg["java_base"] = args.java_api_base
    rt.write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")

    mcp_conf = installer(args, packs)

    # P1-4 修正：ack 解除后置——安装全部成功才落（解除先于安装=失败安装
    # 也绕过了恢复门禁语义）
    if pending_ack:
        marker = Path.home() / ".codex" / "vod-collect-suspended.json"
        if marker.is_file():
            marker.unlink()
        audit = Path.home() / ".codex" / "vod-collect-suspension-audit.log"
        with audit.open("a", encoding="utf-8") as f:
            f.write(f"{datetime.datetime.now().isoformat(timespec='seconds')}\t"
                    f"ack_suspension\tpacks={packs}\n")
        print(f"[vod-devkit] 已显式解除 codex 采集熔断（安装成功），审计已记录：{audit}")

    # G1 修复：技能全量拷贝（目录型技能+平铺规则文档），按 packs 过滤
    extra_dirs = _install_skills(target, packs,
                                 (getattr(args, "dsh_profile", "") or "").strip() or None)

    _write_install_manifest(args, target, packs, bound_product, mcp_conf,
                            extra_dirs)


def _install_skills(target: str, packs: str, profile: str | None = None):
    """技能段：按 packs 过滤后拷到 hermes 主目录 + 目标宿主的技能发现目录。

    目标宿主列表由 integrations/<host>/host.json 的 skillsDir 决定——2026-11-11
    实锤：dsh 此前不在拷贝分支里，npx 装 dsh 只拿到工具、拿不到任何技能文
    件（同意前置/逐字回显/追问判定这些话术纪律整层缺失），而 ~/.dsh/skills
    下的副本是 /opt/vod-install 脚本手工刷的，不是安装器产物。
    返回 [(host, Path)] 落点清单（供 manifest 名册对账）。"""
    HERMES_SKILLS_DIR.mkdir(parents=True, exist_ok=True)
    # opencode 原生技能目录（2026-11-06 实测：opencode 自动发现
    # ~/.config/opencode/skills/ 并经 skill 工具按需加载——此前安装器漏拷，
    # opencode 只有工具描述一条约束通道，话术类约束全部失效）
    extra_dirs = []  # [(host, Path)]
    spec = host_specs.load(target, profile)
    if spec.get("skillsDir") and target != "hermes":
        dst = Path(spec["skillsDir"])
        dst.mkdir(parents=True, exist_ok=True)
        extra_dirs.append((target, dst))
    pack_set = set(p for p in packs.split(",") if p)
    for entry in sorted((ROOT / "skills").iterdir()):
        if entry.is_dir():  # vod-core / vod-feedback-collect
            skill = entry.name
            if skill == "vod-core" and "core" not in pack_set:
                continue
            if skill == "vod-feedback-collect" and "collect" not in pack_set:
                continue
            dst = HERMES_SKILLS_DIR / skill
            if dst.exists():
                shutil.rmtree(dst)
            shutil.copytree(entry, dst)
            for _host, oc_dst in extra_dirs:
                dst2 = oc_dst / skill
                if dst2.exists():
                    shutil.rmtree(dst2)
                shutil.copytree(entry, dst2)
        # vendored 领域规则已由 vendor_rules.py 落成技能目录结构
    return extra_dirs


def _write_install_manifest(args, target, packs, bound_product, mcp_conf,
                            extra_dirs) -> None:
    """manifest 段：落安装名册（版本/来源/归因/落点指纹），并给出 key
    配置提示。名册对账口径见各字段注释（原 cmd_install 尾段，整段平移）。"""
    bi = json.loads((ROOT / "build-info.json").read_text(encoding="utf-8"))
    manifest = {
        "version": bi["version"],
        "source": {"type": "git", "remote": bi["sourceRemote"],
                   "ref": subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
                                         cwd=ROOT, capture_output=True, text=True).stdout.strip(),
                   "commitSha": bi["commitSha"]},
        "target": target,
        "installedAt": datetime.datetime.now().isoformat(timespec="seconds"),
        "preset": args.preset,
        "distribution": getattr(args, "distribution", "devkit"),
        "product": bound_product,
        "packs": packs,
        "dshProfile": (getattr(args, "dsh_profile", "") or "").strip() or None,
        # dsh 修复用（S60/A 止血）：patch 块被 dsh 运行时序列化冲掉后，
        # doctor 可凭 product/apiBase 重建（块内容=安装期静态部署值）
        "apiBase": (getattr(args, "java_api_base", "") or "") or None,
        "mcpConfig": (str(mcp_conf) if mcp_conf else None),
        "skillsDir": str(HERMES_SKILLS_DIR),
        # 名册对账（huaweicloud-devkit doctor 模式借鉴，2026-11-06）：
        # 每个原生技能落点的独立指纹——漏装/漂移可被 doctor 逐落点抓出，
        # 不再只盯 hermes 单目录（opencode 漏拷静默失效的针对性防线）。
        # 多宿主并集合并：manifest 按「最近一次安装」覆盖会互相冲掉落点
        # （实锤：codex 装完 opencode 落点消失），按 host+dir 去重保留历史
        "skillInstalls": _skill_installs(manifest_path(), extra_dirs),
        "skillHashes": _skill_hashes(),
    }
    manifest_path().write_text(json.dumps(manifest, ensure_ascii=False, indent=2),
                               encoding="utf-8")
    print("installed:", json.dumps(manifest, ensure_ascii=False, indent=2))
    missing = [k for k in ("VOD_JAVA_API_KEY",) if
               not os.environ.get(k) and not _runtime_cfg_read().get("java_key")]
    if missing:
        print(f"提示：{missing} 未配置——首次提交将自动申请零字段匿名令牌（无需配置）")


def _runtime_cfg_read() -> dict:
    p = ROOT / "vod_mcp" / "runtime.json"
    if p.exists():
        try:
            return json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            return {}
    return {}



def cmd_status(_args):
    p = manifest_path()
    if not p.exists():
        print("未安装（无 install-manifest）")
        sys.exit(1)
    # golden 稳定性：apiBase 含安装期动态值（本地验证实例端口），归一化后输出
    text = p.read_text(encoding="utf-8")
    text = re.sub(r'"apiBase": "http://127\.0\.0\.1:\d+"',
                  '"apiBase": "http://127.0.0.1:<PORT>"', text)
    print(text)


def _repair_dsh_patch_block(mf: dict) -> str | None:
    """doctor 自愈（S58/A）：profile cordis.patch.yml 的 vod-devkit 块缺失或
    打平（未缩进在 - insert: 之下）时，按 manifest 的 product/apiBase 重建
    正确嵌套块。返回修复的文件路径；块完好返回 None。

    嵌套铁律（真机实锤）：id/name/config 必须缩进在 `- insert:` 之下——
    dsh 的配置序列化只保留它能识别的块，手工游离块会被下次写盘冲掉。
    """
    prof = mf["dshProfile"]
    patch = Path(host_specs.load("dsh", prof)["configPath"])
    if not patch.exists():
        return None
    from vod_mcp import config_forms as cf
    lines = patch.read_text(encoding="utf-8").splitlines()
    try:
        verdict, reason = cf.classify_dsh_patch(lines)
    except cf.Refused as e:
        verdict, reason = "refuse", str(e)
    if verdict == "refuse":
        # 自愈也不越界：文件形态未知时只报告，不动字节
        print(f"[doctor] skip（cordis.patch.yml 形态不受支持，未自愈）：{reason}",
              file=sys.stderr)
        return None
    vod_idx = next((i for i, ln in enumerate(lines)
                    if ln.strip().startswith("- id: vod-devkit")), None)
    if vod_idx is not None and lines[vod_idx].startswith((" ", "\t")):
        # 已嵌套且在 insert 组内（简化判定：缩进+前文存在 - insert: 行）→ 完好
        has_insert = any(ln.strip() == "- insert:" for ln in lines[:vod_idx])
        has_name = any("name: dsh-vod-devkit" in ln
                       for ln in lines[vod_idx:vod_idx + 3])
        if has_insert and has_name:
            return None
    # 需要重建：先摘除旧块（块边界=下一个 `- ` 群组项，任何缩进），再追加正确嵌套组
    if vod_idx is not None:
        end = next((j for j in range(vod_idx + 1, len(lines))
                    if lines[j].strip().startswith("- ")), len(lines))
        del lines[vod_idx:end]
    if lines and lines[-1].strip():
        lines.append("")
    product = mf.get("product") or ""
    api_base = mf.get("apiBase") or ""
    lines += [
        "- insert:",
        "    - id: vod-devkit",
        "      name: dsh-vod-devkit",
        "      config:",
        f"        product: {product}",
        f"        apiBase: {api_base}",
        f"        uiBase: {api_base}",  # D-uiBase-direct：浏览器半直连，与 install 同口径
    ]
    patch.write_text("\n".join(lines).rstrip("\n") + "\n", encoding="utf-8")
    return str(patch)


def cmd_doctor(_args):
    problems = []
    p = manifest_path()
    if not p.exists():
        problems.append("无 install-manifest.json（未 install？）")
    else:
        mf = json.loads(p.read_text(encoding="utf-8"))
        # dsh patch 块自愈（S58/A 止血，2026-11-06 真机实锤）：dsh 运行时
        # 序列化会冲掉 profile patch 里的 vod 块（配置树不含手工块）——
        # doctor 检测缺失/打平后按 manifest 的 product/apiBase 重建嵌套块
        if mf.get("target") == "dsh" and mf.get("dshProfile"):
            patched = _repair_dsh_patch_block(mf)
            if patched:
                print(f"[doctor] 已重建 dsh patch 的 vod-devkit 块：{patched}"
                      "（重启 dsh 生效）")
        bi = json.loads((ROOT / "build-info.json").read_text(encoding="utf-8"))
        if mf["source"]["commitSha"] != bi.get("commitSha"):
            problems.append("install-manifest 与 build-info 的 commitSHA 不一致")
        if mf.get("mcpConfig") and not Path(mf["mcpConfig"]).exists():
            problems.append("MCP 配置文件缺失")
        if not Path(mf["skillsDir"]).exists():
            problems.append("skills 目录缺失")
        drifted = _drifted_skills(mf)
        if drifted:
            problems.append("技能拷贝件与安装产物漂移（D-drift-lock）："
                            + "、".join(drifted) + "——重跑 install 恢复")
        # 名册对账（逐原生落点）：漏装/漂移按宿主点名（借鉴 devkit doctor）
        for si in mf.get("skillInstalls") or []:
            d = Path(si["dir"])
            if not d.exists():
                problems.append(f"技能原生副本缺失（{si['host']}）：{d} 不存在"
                                "——重跑 install 恢复")
                continue
            import hashlib
            expect = mf.get("skillHashes") or {}
            for rel, sha in expect.items():
                f = d / rel
                if not f.exists():
                    problems.append(f"技能文件缺失（{si['host']}）：{rel}")
                elif hashlib.sha256(f.read_bytes()).hexdigest() != sha:
                    problems.append(f"技能文件漂移（{si['host']}）：{rel}")
    if problems:
        for x in problems:
            print("FAIL:", x)
        sys.exit(1)
    # key 探针（最佳努力）：配置了 key 就问一次引擎，无效当场报；网络不可达只提示不 FAIL
    #（离线环境 doctor 必须可用——网络问题不是 key 问题）
    from vod_mcp.tools import _runtime_cfg
    key = os.environ.get("VOD_JAVA_API_KEY") or _runtime_cfg().get("java_key")
    if key:
        from vod_mcp.tools import probe_key
        chk = probe_key(key)
        if chk["ok"] is False:
            problems.append(f"key 无效（指纹 {chk['fingerprint']}，引擎 401 拒绝）——"
                            "请核对/续期，或移除 key 走匿名档")
        elif chk["ok"] is None:
            print(f"warn: key 未验证（引擎不可达，指纹 {chk['fingerprint']}）")
        else:
            print(f"key: 有效（指纹 {chk['fingerprint']}）")
    if problems:
        for x in problems:
            print("FAIL:", x)
        sys.exit(1)
    print("doctor: OK")


def _distribution() -> str:
    """分发形态位（D-key-guard-3）：install --distribution 写入，构建期定死。
    devkit=开发/运维形态（自装自管）；preset=产品随 agent 分发（客户机只读）。"""
    p = manifest_path()
    if not p.exists():
        return "devkit"
    try:
        return json.loads(p.read_text(encoding="utf-8")).get("distribution", "devkit")
    except Exception:
        return "devkit"


def cmd_verify(_args):
    p = manifest_path()
    if not p.exists():
        print("未安装")
        sys.exit(1)
    sha = json.loads(p.read_text(encoding="utf-8"))["source"]["commitSha"]
    if not sha:
        print("manifest 无 commitSha（dev 构建无法核验）")
        sys.exit(1)
    if _distribution() == "preset":
        # D-key-guard-3②：产品分发形态客户机无 git 源——只做本地完整性校验，
        # 源端比对降级为 unchecked 不 FAIL（离线 verify 必须可用）
        bi = json.loads((ROOT / "build-info.json").read_text(encoding="utf-8"))
        if sha != bi.get("commitSha"):
            print("FAIL: manifest 与 build-info commitSHA 不一致（安装产物被篡改/混装）")
            sys.exit(1)
        print("verify: OK（preset 本地完整性；源端比对 unchecked）")
        return
    r = subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"],
                       cwd=ROOT, capture_output=True)
    if r.returncode != 0:
        subprocess.run(["git", "fetch", "origin"], cwd=ROOT)
        r = subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"],
                           cwd=ROOT, capture_output=True)
    if r.returncode != 0:
        print(f"FAIL: commit {sha} 不存在于 origin（被改写或非本仓产物）")
        sys.exit(1)
    print(f"verify: OK（commit {sha[:12]} 存在于本仓/origin）")


def cmd_update(_args):
    """更新：git fetch 比较 origin/main，落后则 ff 拉取并重烧 build-info。"""
    if _distribution() == "preset":
        # D-key-guard-3②：产品分发形态插件版本随 agent 发版管理，客户机禁止自更新
        #（绕过产品版本管理=未测试代码进客户现场）
        print("产品分发形态（preset）不支持自更新：插件版本随 agent 发版管理。"
              "如需升级请联系产品提供方发布新版本。")
        return
    subprocess.run(["git", "fetch", "origin", "--tags"], cwd=ROOT, capture_output=True)
    local = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT,
                           capture_output=True, text=True).stdout.strip()
    remote = subprocess.run(["git", "rev-parse", "origin/main"], cwd=ROOT,
                            capture_output=True, text=True).stdout.strip()
    if local == remote:
        print(f"已是最新（{local[:12]}）")
        return
    r = subprocess.run(["git", "pull", "--ff-only"], cwd=ROOT,
                       capture_output=True, text=True)
    if r.returncode != 0:
        print("更新失败（有本地改动阻挡 ff？）：", r.stderr.strip()[:200])
        sys.exit(1)
    print(f"已更新 {local[:12]} → {remote[:12]}")
    write_build_info(strict=False)
    print("build-info 已重烧；如需重新安装执行：")
    print(f"  {sys.argv[0]} install --target hermes --preset collect --product <产品名>")
    print("  并重启 agent 会话")


def cmd_uninstall(_args):
    p = manifest_path()
    if p.exists():
        mf = json.loads(p.read_text(encoding="utf-8"))
        for key in ("mcpConfig", "skillsDir"):
            path_s = mf.get(key)
            if not path_s:
                continue  # codex 等宿主 mcpConfig 可为 None（P0-3：无托管配置文件）
            path = Path(path_s)
            # 深审 P0-3（破坏性路径一票否决）：config.toml 是用户整份 codex
            # 配置，永不在 uninstall 删除——旧版 manifest 曾把它记成 mcpConfig
            if path.name == "config.toml":
                print(f"skip（用户配置文件，uninstall 永不删除）：{path}")
                continue
            if path.exists():
                shutil.rmtree(path) if path.is_dir() else path.unlink()
                print("removed:", path)
        # codex 原生插件摘除（best-effort：CLI 命令名随版本可能变化，失败不阻塞）
        if mf.get("target") == "codex":
            codex = shutil.which("codex")
            if codex:
                r = subprocess.run([codex, "plugin", "remove",
                                    "vod-devkit@vod-local"],
                                   capture_output=True, text=True, timeout=120)
                print("codex plugin remove:",
                      "OK" if r.returncode == 0
                      else (r.stderr or r.stdout).strip()[-120:])
        for g in host_specs.load("opencode")["generated"]:
            gen = Path(g["dest"])
            if gen.exists():
                gen.unlink()
                print("removed:", gen)
        # dsh 壳（D-dsh-install-1）：摘插件 + 从 profile patch 移除 config 段
        dsh = shutil.which("dsh")
        if dsh:
            prof = (mf.get("dshProfile") or "").strip()
            if prof:
                subprocess.run([dsh, "plugin", "--profile", prof, "remove",
                                "dsh-vod-devkit"], capture_output=True, text=True)
            if prof:  # 无 profile 记录=没写过 patch，无需（也无法）摘除
                patch = Path(host_specs.load("dsh", prof)["configPath"])
                if _remove_dsh_patch_block(patch):
                    print("removed vod-devkit config block:", patch)
        p.unlink()
        print("removed:", p)
    else:
        print("未安装")


def main():
    # `serve` 后的参数整体透传给 MCP server（argparse 的 REMAINDER 会把
    # --transport 当成未知参数拦下，devkit 的二进制本身就是 server，同形处理）
    if len(sys.argv) > 1 and sys.argv[1] == "serve":
        os.execv(sys.executable,
                 [sys.executable, str(ROOT / "vod_mcp" / "server.py"), *sys.argv[2:]])
    ap = argparse.ArgumentParser(prog="vod-devkit")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sp = sub.add_parser("install")
    sp.add_argument("--target", default="auto",
                    help="hermes|opencode|codex|dsh|auto（默认探测）")
    sp.add_argument("--preset", default="collect", choices=list(PRESETS),
                    help="collect=对外默认（采集者）；full=内部全量")
    sp.add_argument("--api-base", default="http://127.0.0.1:8000")
    sp.add_argument("--java-api-base", default=None,
                    help="VOD 平台地址（缺省=https://vod-dev.topxtopx.com，勿用回环默认）")
    sp.add_argument("--packs", default="", help="显式覆盖 preset（逗号分隔）")
    sp.add_argument("--ack-suspension", action="store_true",
                     help="确认解除 codex 采集熔断（恢复门禁逃生口，D-codex-circuit-breaker-1）")
    sp.add_argument("--product", default="",
                    help="归因绑定：本 agent 服务的产品（codearts/aishell 等；采集反馈默认归属）")
    sp.add_argument("--distribution", default="devkit", choices=["devkit", "preset"],
                    help="devkit=开发/运维自装（默认）；preset=产品随 agent 分发（禁 key 随包/"
                         "禁自更新/客户机首启重生成状态）")
    sp.add_argument("--profile", dest="dsh_profile", default="",
                    help="dsh 专用：profile 名（--target dsh 时必填）")
    sp.add_argument("--no-local-ledger", action="store_true",
                    help="关闭本地提交账本（企业数据驻留要求；vod_list_submitted 将不可用）")
    sp.set_defaults(fn=cmd_install)
    for name, fn in (("status", cmd_status), ("doctor", cmd_doctor),
                     ("verify", cmd_verify), ("update", cmd_update),
                     ("uninstall", cmd_uninstall)):
        s = sub.add_parser(name)
        s.set_defaults(fn=fn)
    sub.add_parser("build-info").set_defaults(fn=lambda a: write_build_info(strict=False))

    def _serve(a):
        """MCP server 入口（codex 插件 .mcp.json 与远程面共用）。

        透传参数：`vod-devkit serve --transport remote --port 9528` 即起 HTTP 面
        （与 huaweicloud-devkit 的 `--transport remote` 同形）。
        """
        extra = list(getattr(a, "server_args", []) or [])
        os.execv(sys.executable,
                 [sys.executable, str(ROOT / "vod_mcp" / "server.py"), *extra])
    sp_serve = sub.add_parser("serve", help="启动 MCP server（默认 stdio；"
                                            "--transport remote 起 Streamable HTTP）")
    sp_serve.add_argument("server_args", nargs=argparse.REMAINDER,
                          help="透传给 vod_mcp.server（如 --transport remote --port 9528）")
    sp_serve.set_defaults(fn=_serve)
    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
