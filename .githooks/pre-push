#!/bin/bash
# pre-push 质量门：push 前强制 pytest+pyflakes（GitCode Actions 平台不可用期间的本地机器门禁）
PY=$(ls /root/.hermes/tools/python-3.14.7*/bin/python3 2>/dev/null || command -v python3)
LIBS=/root/.hermes/cache/scratch/pylibs
if [ -d "$LIBS" ]; then export PYTHONPATH="$LIBS:$PYTHONPATH"; fi
echo "[pre-push] lint..."
"$PY" -m pyflakes vod_mcp tests || { echo "[pre-push] FAIL: lint 未过，禁止推送"; exit 1; }
echo "[pre-push] pytest..."
"$PY" -m pytest tests/ -q || { echo "[pre-push] FAIL: 测试未过，禁止推送"; exit 1; }
echo "[pre-push] 双副本一致性（生成物同步 + 内容一致 + 副本零提交）..."
"$PY" scripts/sync_plugin.py >/dev/null || { echo "[pre-push] FAIL: sync_plugin 失败"; exit 1; }
"$PY" scripts/verify_copies.py || { echo "[pre-push] FAIL: 双副本漂移——重跑 scripts/sync_plugin.py 后重试"; exit 1; }
echo "[pre-push] dsh 壳测试（归因对账/回执守卫/UI 全局）..."
if command -v node >/dev/null 2>&1 && [ -d dsh/node_modules ]; then
  ( cd dsh && node --test test/*.test.mjs >/tmp/prepush-dsh.log 2>&1 ) \
    || { echo "[pre-push] FAIL: dsh 测试未过（见 /tmp/prepush-dsh.log）"; exit 1; }
else
  echo "[pre-push] SKIP: 缺 node 或 dsh/node_modules（npm install 后覆盖）"
fi
echo "[pre-push] secret/high-risk scan..."
"$PY" scripts/secret_scan.py || { echo "[pre-push] FAIL: 凭据/高危扫描未过，禁止推送"; exit 1; }
echo "[pre-push] OK"
