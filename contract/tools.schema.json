{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vod-devkit MCP 工具契约（唯一事实源）",
  "version": "0.1.0",
  "tools": {
    "vod_submit_voices": {
      "description": "提交 agent 产品用户反馈声音（写，需确认）。对接 Java 现有 POST /external/voice/submit（提交即分析）。voiceId=调用级唯一（跨调用不去重保声量，R1）；title=用户原文（R3）。缺 key 时自动获取零字段匿名令牌。",
      "input": {
        "type": "object",
        "properties": {
          "voices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "scene": {
                  "type": "string"
                },
                "userType": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "content"
              ]
            },
            "description": "用户反馈声音列表（content 必填）"
          },
          "confirmed": {
            "type": "boolean",
            "default": false,
            "description": "用户已确认为 true 才执行（confirm 护栏，逐次同意）"
          },
          "product": {
            "type": "string",
            "enum": [
              "agentarts",
              "codearts",
              "dataarts",
              "maas",
              "obs",
              "officeclaw"
            ],
            "default": "codearts",
            "description": "反馈针对的产品（插件白名单值，映射引擎枚举名）"
          }
        },
        "required": [
          "voices"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer"
          },
          "voiceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rejected": {
            "type": "array"
          },
          "taskIds": {
            "type": "array",
            "items": {
              "type": [
                "integer",
                "null"
              ]
            },
            "description": "引擎分析任务 ID（与 voiceIds 对位；幂等重发为 null）"
          }
        },
        "required": [
          "accepted",
          "voiceIds"
        ]
      },
      "backend": "java(VOD_JAVA_API_BASE+VOD_JAVA_API_KEY)；现有 /external/voice/submit"
    },
    "vod_devkit_info": {
      "description": "插件自述（只读，core pack 常驻）：版本/commitSHA/宿主身份/安装信息。",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "commitSha": {
            "type": "string"
          },
          "hostClient": {
            "type": "object"
          }
        },
        "required": [
          "version",
          "commitSha"
        ]
      },
      "backend": "local(无上游)"
    },
    "vod_auth_status": {
      "description": "认证自检（只读，无 key 也能跑）：报告双后端 key 配置态（指纹非明文）、连通性、环境指向、生效 packs。缺 key 时输出结构化引导（申请步骤）。",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "javaKey": {
            "type": "object"
          },
          "workflowKey": {
            "type": "object"
          },
          "packs": {
            "type": "array"
          },
          "guidance": {
            "type": "array"
          }
        },
        "required": [
          "javaKey",
          "workflowKey"
        ]
      },
      "backend": "local(无上游；探测时轻量 ping)"
    }
  },
  "backends": {
    "java": {
      "base": "VOD_JAVA_API_BASE",
      "key": "VOD_JAVA_API_KEY",
      "auth": "ExternalApiKeyFilter Bearer"
    },
    "local": {
      "base": null,
      "key": null,
      "auth": null
    }
  }
}