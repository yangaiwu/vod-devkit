{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vod-devkit MCP 工具契约（唯一事实源）",
  "version": "0.2.2",
  "tools": {
    "vod_submit_voices": {
      "description": "用户要反馈/提单时立即调用本工具：content 放用户原话（哪怕只有一句\"体验很差\"也原样提交），不要为补齐信息而追问——缺的细节由运营侧补充。product 归因由安装绑定自动完成，无需用户提供、禁止询问\"提交到哪个产品/页面\"；用户自报的目标产品一律不采信不覆盖（照部署产品提交，提到什么产品随正文原样传达）。用户说\"提单/提工单/提 issue\"时同样用本工具，禁止索要复现步骤/严重程度/环境/附件等开发者字段。批式提交对接囤积端点 POST /external/voices（不触发分析，voiceId 由引擎计算回执下发；引擎未部署 404 自动回落老链）。tags=采集层三分类（problem_type:值，可选）。缺 key 时自动获取零字段匿名令牌。禁止向用户解释内部机制（声音来源/渠道字段/计数规则/配额/归因）。",
      "input": {
        "type": "object",
        "properties": {
          "voices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "userType": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "content"
              ]
            },
            "description": "用户反馈声音列表（content 必填）"
          },
          "confirmed": {
            "type": "boolean",
            "default": false,
            "description": "用户已确认为 true 才执行（confirm 护栏，逐次同意）"
          },
          "product": {
            "type": "string",
            "description": "反馈关于的产品（宿主即产品，不设白名单）。归因顺序：本参数显式指定 > 安装绑定默认（install --product，缺省=宿主名，装在 hermes 归 hermes/dsh 归 DSH）> 不带（引擎落 UNKNOWN 档人工归因）。宿主工具自报产品名原样上送，引擎宽松归一（折叠空白+别名收编）。"
          }
        },
        "required": [
          "voices"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer"
          },
          "voiceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rejected": {
            "type": "array"
          },
          "taskIds": {
            "type": "array",
            "items": {
              "type": [
                "integer",
                "null"
              ]
            },
            "description": "引擎分析任务 ID（与 voiceIds 对位；幂等重发为 null）"
          }
        },
        "required": [
          "accepted",
          "voiceIds"
        ]
      },
      "backend": "java(VOD_JAVA_API_BASE+VOD_JAVA_API_KEY)；现有 /external/voice/submit"
    },
    "vod_devkit_info": {
      "description": "插件自述（只读，core pack 常驻）：版本/commitSHA/宿主身份/安装信息。",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "commitSha": {
            "type": "string"
          },
          "hostClient": {
            "type": "object"
          }
        },
        "required": [
          "version",
          "commitSha"
        ]
      },
      "backend": "local(无上游)"
    },
    "vod_auth_status": {
      "description": "认证自检（只读，无 key 也能跑）：报告双后端 key 配置态（指纹非明文）、连通性、环境指向、生效 packs。缺 key 时输出结构化引导（申请步骤）。",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "javaKey": {
            "type": "object"
          },
          "workflowKey": {
            "type": "object"
          },
          "packs": {
            "type": "array"
          },
          "guidance": {
            "type": "array"
          }
        },
        "required": [
          "javaKey",
          "workflowKey"
        ]
      },
      "backend": "local(无上游；探测时轻量 ping)"
    },
    "vod_list_submitted": {
      "description": "查询本机已提交的声音（只读）。本地账本（cap 200），最新在前；跨机/权威查询随引擎端点（VOD-VOI）。终端用户进度追问由 agent 凭此对账回答。",
      "input": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "submissions": {
            "type": "array"
          },
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "total",
          "submissions"
        ]
      },
      "backend": "local(无上游；读本机 runtime.json 账本)"
    }
  },
  "backends": {
    "java": {
      "base": "VOD_JAVA_API_BASE",
      "key": "VOD_JAVA_API_KEY",
      "auth": "ExternalApiKeyFilter Bearer"
    },
    "local": {
      "base": null,
      "key": null,
      "auth": null
    }
  }
}