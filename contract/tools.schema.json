{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vod-devkit MCP 工具契约（唯一事实源）",
  "version": "0.1.0",
  "tools": {
    "vod_run_analysis": {
      "description": "发起 VOD 分析任务（写操作，需确认）。调用引擎 POST /api/vod/analyze/json，返回 taskId 作为对账主键。",
      "input": {
        "type": "object",
        "properties": {
          "product": {"type": "string", "enum": ["agentarts", "codearts", "dataarts", "maas", "obs", "officeclaw"], "description": "产品 profile（白名单）"},
          "data": {"type": "array", "items": {"type": "object"}, "description": "声音数据（JSON 记录数组）"},
          "max_voices": {"type": "integer", "minimum": 1, "maximum": 500, "default": 500},
          "confirmed": {"type": "boolean", "default": false, "description": "用户已确认为 true 才执行（confirm 护栏）"}
        },
        "required": ["product", "data"]
      },
      "output": {
        "type": "object",
        "properties": {"taskId": {"type": "string"}, "status": {"type": "string"}, "createdAt": {"type": "string"}},
        "required": ["taskId"]
      }
    },
    "vod_task_status": {
      "description": "查询任务状态（只读）。GET /api/vod/status/{taskId}。",
      "input": {"type": "object", "properties": {"taskId": {"type": "string"}}, "required": ["taskId"]},
      "output": {"type": "object", "properties": {"taskId": {"type": "string"}, "status": {"type": "string"}, "current_step": {"type": "string"}, "updatedAt": {"type": "string"}}, "required": ["taskId", "status"]}
    },
    "vod_task_result": {
      "description": "获取任务结果（只读）。GET /api/vod/result/{taskId}。与 vod-system 前端同源。",
      "input": {"type": "object", "properties": {"taskId": {"type": "string"}}, "required": ["taskId"]},
      "output": {"type": "object", "properties": {"taskId": {"type": "string"}, "results": {"type": "array"}}, "required": ["taskId"]}
    },
    "vod_kb_search": {
      "description": "KB 精准检索（只读）。引擎侧前置：/api/vod/knowledge/query 端点尚缺（见 design.md 前置缺口）。",
      "input": {"type": "object", "properties": {"query": {"type": "string"}, "top_k": {"type": "integer", "minimum": 1, "maximum": 20, "default": 5}}, "required": ["query"]},
      "output": {"type": "object", "properties": {"hits": {"type": "array", "items": {"type": "object"}}}, "required": ["hits"]}
    },
    "vod_devkit_info": {
      "description": "插件自述（只读，core pack 常驻）：版本/commitSHA/宿主身份/安装信息。",
      "input": {"type": "object", "properties": {}},
      "output": {"type": "object", "properties": {"version": {"type": "string"}, "commitSha": {"type": "string"}, "hostClient": {"type": "object"}}, "required": ["version", "commitSha"]}
    }
  }
}
